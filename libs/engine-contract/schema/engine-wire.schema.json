        "reason",
        "reason_message",
        "reason_lead",
        "reason_detail",
        "style_key",
        "source_size",
        "origin_x",
        "origin_y",
        "source_rects",
        "warnings"
      ],
      "title": "UnitCoverage",
      "type": "object"
    },
